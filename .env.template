# OpenAI API Key (required)
OPENAI_API_KEY=ollama

OPENAI_BASE_URL=http://localhost:11434/v1

# Vector database (default: faiss)
VECTOR_DB=faiss

# Embedding model (multilingual recommended)
EMBEDDING_MODEL=nomic-embed-text

# LLM model for generation
LLM_MODEL=llama3.2

# Enable Whisper API for speech-to-text (true/false)
WHISPER_API=false

# Optional: Pinecone settings (if using Pinecone instead of FAISS)
# PINECONE_API_KEY=
# PINECONE_ENV=
